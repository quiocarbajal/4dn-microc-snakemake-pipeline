# =============================================================================
# Snakemake 9 Workflow: Official 4DN v43 Hi-C / Micro-C Processing Pipeline
# =============================================================================
# Official Documentation: https://data.4dnucleome.org/resources/data-analysis/hi_c-processing-pipeline
# Official GitHub: https://github.com/4dn-dcic/docker-4dn-hic (Release v43)
# =============================================================================

# Include modular rule specifications
include: "rules/00_common.smk"
include: "rules/00_reference.smk"
include: "rules/01_qc.smk"
include: "rules/02_alignment.smk"
include: "rules/03_pairtools.smk"
include: "rules/04_matrices.smk"
include: "rules/05_downstream.smk"
include: "rules/06_provenance.smk"

# -----------------------------------------------------------------------------
# Target: FastQC Read Quality Control Only
# -----------------------------------------------------------------------------
rule fastqc:
    input:
        fastqc_r1 = [f"{OUTDIR}/qc/fastqc/{s}_{r}_R1_fastqc.zip" for s, r in SAMPLE_RUN_MAP.keys()],
        fastqc_r2 = [f"{OUTDIR}/qc/fastqc/{s}_{r}_R2_fastqc.zip" for s, r in SAMPLE_RUN_MAP.keys()]

# -----------------------------------------------------------------------------
# Target: 4DN Official Processing & QC Layer (Primary Deliverables)
# -----------------------------------------------------------------------------
rule four_dn:
    input:
        # FastQC read quality control (optional, controlled by config["qc"]["run_fastqc"])
        fastqc_r1 = [f"{OUTDIR}/qc/fastqc/{s}_{r}_R1_fastqc.zip" for s, r in SAMPLE_RUN_MAP.keys()] if config.get("qc", {}).get("run_fastqc", True) else [],
        fastqc_r2 = [f"{OUTDIR}/qc/fastqc/{s}_{r}_R2_fastqc.zip" for s, r in SAMPLE_RUN_MAP.keys()] if config.get("qc", {}).get("run_fastqc", True) else [],
        
        # Optional BAM retention
        bam = [f"{OUTDIR}/bam/{s}_{r}.bam" for s, r in SAMPLE_RUN_MAP.keys()] if SAVE_BAM else [],
        
        # Individual biological replicate valid pairs & indexes (.pairs.gz & .px2)
        pairs = expand(f"{OUTDIR}/pairs/{{sample}}.ff.pairs.gz", sample=SAMPLES),
        px2 = expand(f"{OUTDIR}/pairs/{{sample}}.ff.pairs.gz.px2", sample=SAMPLES),
        
        # Individual biological replicate contact matrices (.mcool and optional .hic)
        mcool = expand(f"{OUTDIR}/mcool/{{sample}}.mcool", sample=SAMPLES),
        hic = expand(f"{OUTDIR}/hic/{{sample}}.hic", sample=SAMPLES) if config.get("matrix", {}).get("generate_hic", False) else [],
        
        # Individual biological replicate 4DN pairsqc reports
        pairsqc = expand(f"{OUTDIR}/qc/pairsqc/{{sample}}_report.zip", sample=SAMPLES) if config.get("qc", {}).get("run_pairsqc", True) else [],
        
        # Merged biological replicate deliverables (for conditions with >1 biological replicate)
        merged_pairs = expand(f"{OUTDIR}/pairs_merged/{{condition}}.merged.ff.pairs.gz", condition=MULTI_REP_CONDITIONS),
        merged_px2 = expand(f"{OUTDIR}/pairs_merged/{{condition}}.merged.ff.pairs.gz.px2", condition=MULTI_REP_CONDITIONS),
        merged_mcool = expand(f"{OUTDIR}/mcool_merged/{{condition}}.mcool", condition=MULTI_REP_CONDITIONS),
        merged_hic = expand(f"{OUTDIR}/hic_merged/{{condition}}.hic", condition=MULTI_REP_CONDITIONS) if config.get("matrix", {}).get("generate_hic", False) else [],
        merged_pairsqc = expand(f"{OUTDIR}/qc/pairsqc_merged/{{condition}}_merged_report.zip", condition=MULTI_REP_CONDITIONS) if config.get("qc", {}).get("run_pairsqc", True) else [],
        
        # Optional Raichu Normalization
        raichu = expand(f"{OUTDIR}/mcool/{{sample}}.raichu_done", sample=SAMPLES) if config.get("matrix", {}).get("run_raichu", False) else [],
        merged_raichu = expand(f"{OUTDIR}/mcool_merged/{{condition}}.raichu_done", condition=MULTI_REP_CONDITIONS) if config.get("matrix", {}).get("run_raichu", False) else [],
        
        # Provenance metadata
        provenance = f"{OUTDIR}/provenance.json"

# -----------------------------------------------------------------------------
# Target: Optional Downstream Analysis Layer (cooltools)
# -----------------------------------------------------------------------------
rule downstream:
    input:
        expected = expand(f"{OUTDIR}/downstream/expected/{{sample}}_expected_{EXP_RES}bp.tsv", sample=SAMPLES) if config.get("downstream", {}).get("run_expected", True) else [],
        insulation = expand(f"{OUTDIR}/downstream/insulation/{{sample}}_insulation_{INS_RES}bp.tsv", sample=SAMPLES) if config.get("downstream", {}).get("run_insulation", True) else [],
        compartments = expand(f"{OUTDIR}/downstream/compartments/{{sample}}_eigs_{COMP_RES}bp.cis.vecs.tsv", sample=SAMPLES) if config.get("downstream", {}).get("run_compartments", True) else []

# -----------------------------------------------------------------------------
# Default Target: Complete Workflow (4DN Layer + Optional Downstream)
# -----------------------------------------------------------------------------
rule all:
    input:
        rules.four_dn.input,
        rules.downstream.input
